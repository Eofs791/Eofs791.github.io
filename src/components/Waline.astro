---
import "@/styles/waline.css"
---

<div id="waline"></div>

<script type="module" is:inline>
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";

  function initWaline() {
    const container = document.getElementById("waline");
    
    // 防御性判断：
    // 1. 如果当前页面没有 #waline 容器，直接退出
    // 2. 如果容器里已经有子元素了（说明 Waline 已经渲染过了），防止重复渲染
    if (!container || container.children.length > 0) {
      return;
    }

    init({
      el: "#waline",
      serverURL: "https://waline-blush-ten.vercel.app/",
    });
  }

  // 【关键修复 1】立即执行一次：
  // 专门应对从主页第一次跳进来的情况（此时脚本刚被注入，可能完美错过了 page-load 事件）
  initWaline();

  // 【关键修复 2】监听全局生命周期：
  // 专门应对直接刷新文章页，或者在不同文章之间连续跳转的情况
  document.addEventListener("astro:page-load", initWaline);
</script>

<style>
  #waline {
    margin: 2rem 0;
  }
</style>